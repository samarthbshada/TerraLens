# Copy to .env for local development. On Railway set these as service Variables instead.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=mysql://user:password@host:3306/terralens    # optional; default is SQLite
# DATA_DIR=/data                                           # point at a Railway Volume to keep data
# SESSION_COOKIE_SECURE=1                                  # set on Railway (HTTPS)
# MAX_UPLOAD_MB=200
# CD_DETECTOR=classical                                    # or onnx
# CD_ONNX_MODEL=/data/models/changeformer.onnx
